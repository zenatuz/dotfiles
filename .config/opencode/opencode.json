{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/Users/r.batista/.config/opencode/AGENTS.caveman.md"
  ],
  "permission": {
    "skill": {
      "caveman": "allow",
      "caveman-commit": "allow",
      "caveman-review": "allow",
      "caveman-help": "allow",
      "caveman-compress": "allow"
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true,
      "oauth": {}
    },
    "azure": {
      "type": "local",
      "command": ["npx", "-y", "@azure/mcp@latest", "server", "start"],
      "enabled": true
    },
    "azure-devops": {
      "type": "local",
      "command": ["npx", "-y", "@azure-devops/mcp", "keesingtech", "-d", "core", "repositories", "pipelines", "search", "wiki"],
      "enabled": true
    },
    "terraform": {
      "type": "local",
      "command": ["terraform-mcp-server", "stdio"],
      "enabled": true
    }
  }
}
